<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <ImplicitUsings>false</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>8.0</LangVersion>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>SetNet.Mobs.StateSync</PackageId>
        <Version>1.0.0</Version>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
        <Authors>Artem Lemeshev</Authors>
        <Description>StateSync replication adapter for SetNet.Mobs: an IMobReplication that registers a mob archetype (interpolated position, velocity, health, target hash, cast id + remaining) and spawns/mutates/despawns a SetNet.StateSync NetworkEntity per mob, so nearby players observe mobs through the same delta-compressed snapshot stream as everything else. One-line wiring via world.StateSyncReplication() / mobServer.UseStateSyncReplication(world). Depends on SetNet.Mobs + SetNet.StateSync.</Description>
        <PackageTags>networking;mobs;ai;state-sync;replication;game;setnet</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/Povstalez/SetNet.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/Povstalez/SetNet</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
    </PropertyGroup>

    <ItemGroup>
      <None Include="README.md" Pack="true" PackagePath="\" />
      <None Include="../../../assets/icon.png" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="../SetNet.Mobs/SetNet.Mobs.csproj" />
      <ProjectReference Include="../SetNet.StateSync/SetNet.StateSync.csproj" />
    </ItemGroup>

</Project>
