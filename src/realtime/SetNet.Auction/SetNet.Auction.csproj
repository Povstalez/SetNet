<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <ImplicitUsings>false</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>SetNet.Auction</PackageId>
        <Version>1.0.0</Version>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
        <Authors>Artem Lemeshev</Authors>
        <Description>Auction house for SetNet: list items (escrowed from inventory), bid or buy out (currency escrowed, prior bidder refunded), and a background timer settles expired listings — winner gets the item, seller gets the bid, or the item is returned. All moves go through SetNet.Inventory + SetNet.Wallet (no dupes). server.UseAuction(inventory, wallet) + client.UseAuction(). Depends on SetNet + SetNet.Inventory + SetNet.Wallet.</Description>
        <PackageTags>networking;auction;marketplace;bidding;economy;setnet</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/Povstalez/SetNet.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/Povstalez/SetNet</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
    </PropertyGroup>

    <ItemGroup>
      <None Include="README.md" Pack="true" PackagePath="\" />
      <None Include="../../../assets/icon.png" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="../../core/SetNet/SetNet.csproj" />
      <ProjectReference Include="../SetNet.Inventory/SetNet.Inventory.csproj" />
      <ProjectReference Include="../SetNet.Wallet/SetNet.Wallet.csproj" />
    </ItemGroup>

</Project>
