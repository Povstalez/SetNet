<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>9.0</LangVersion>
        <ImplicitUsings>false</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>SetNet.Accounts</PackageId>
        <Version>1.0.0</Version>
        <Authors>Artem Lemeshev</Authors>
        <Description>Account store + authentication for SetNet: a generic AccountServer&lt;TAccount&gt; over any IDocumentStore (memory/file/SQL/Mongo). Register/authenticate with a pluggable password hasher (PBKDF2 default), ban/unban, change password. Subclass AccountBase (or use its Extra bag) to add ANY custom fields with no schema change. Pairs with SetNet.LoginServer. Depends on SetNet + SetNet.Persistence.</Description>
        <PackageTags>networking;accounts;auth;mmo;store;setnet</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/Povstalez/SetNet.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/Povstalez/SetNet</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
    </PropertyGroup>

    <ItemGroup>
      <None Include="README.md" Pack="true" PackagePath="\" />
      <None Include="../../../assets/icon.png" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="../../core/SetNet/SetNet.csproj" />
      <ProjectReference Include="../../infra/SetNet.Persistence/SetNet.Persistence.csproj" />
    </ItemGroup>

</Project>
