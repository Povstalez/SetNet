<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>9.0</LangVersion>
        <ImplicitUsings>false</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>SetNet.CharacterStore</PackageId>
        <Version>1.0.0</Version>
        <Authors>Artem Lemeshev</Authors>
        <Description>Server-side character store for SetNet: a generic CharacterServer&lt;TChar&gt; over any IDocumentStore — create/list-by-account/get/save/rename, per-account slot limit, optional unique names, and soft-delete with a restore window. Subclass CharacterBase (or use its Extra bag) to add ANY custom fields (e.g. a per-character VipUntil) with no schema change. Depends on SetNet + SetNet.Persistence.</Description>
        <PackageTags>networking;character;mmo;save;store;setnet</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/Povstalez/SetNet.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/Povstalez/SetNet</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
    </PropertyGroup>

    <ItemGroup>
      <None Include="README.md" Pack="true" PackagePath="\" />
      <None Include="../../../assets/icon.png" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="../../core/SetNet/SetNet.csproj" />
      <ProjectReference Include="../../infra/SetNet.Persistence/SetNet.Persistence.csproj" />
    </ItemGroup>

</Project>
