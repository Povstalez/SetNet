<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <ImplicitUsings>false</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>SetNet.Guilds</PackageId>
        <Version>1.2.0</Version>
        <AssemblyVersion>1.2.0.0</AssemblyVersion>
        <FileVersion>1.2.0.0</FileVersion>
        <Authors>Artem Lemeshev</Authors>
        <Description>Guilds/clans for SetNet: create/join/leave, roles (member/officer/leader) with promote/kick, membership events, and a shared guild bank backed by a guild-keyed inventory in SetNet.Inventory (atomic, anti-dupe deposits/withdrawals). server.UseGuilds(inventory) + client.UseGuilds(). Pluggable IGuildStore. Depends on SetNet + SetNet.Inventory.</Description>
        <PackageTags>networking;guilds;clans;social;bank;game;setnet</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/Povstalez/SetNet.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/Povstalez/SetNet</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
    </PropertyGroup>

    <ItemGroup>
      <None Include="README.md" Pack="true" PackagePath="\" />
      <None Include="../../../assets/icon.png" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="../../core/SetNet/SetNet.csproj" />
      <ProjectReference Include="../SetNet.Inventory/SetNet.Inventory.csproj" />
    </ItemGroup>

</Project>
