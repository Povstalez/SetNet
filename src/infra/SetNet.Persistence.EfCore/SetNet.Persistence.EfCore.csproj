<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>false</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>SetNet.Persistence.EfCore</PackageId>
        <Version>1.0.0</Version>
        <Authors>Artem Lemeshev</Authors>
        <Description>Entity Framework Core-backed IDocumentStore&lt;T&gt; / ISnapshotStore for SetNet.Persistence. Provider-agnostic — pass DbContextOptions configured for SQLite / PostgreSQL / SQL Server / etc. Each value is stored as JSON in a key/value table, so custom fields need no schema change. Depends on SetNet.Persistence + Microsoft.EntityFrameworkCore(.Relational).</Description>
        <PackageTags>networking;persistence;efcore;entity-framework;store;setnet</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/Povstalez/SetNet.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/Povstalez/SetNet</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
    </PropertyGroup>

    <ItemGroup>
      <None Include="README.md" Pack="true" PackagePath="\" />
      <None Include="../../../assets/icon.png" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.8" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="../SetNet.Persistence/SetNet.Persistence.csproj" />
    </ItemGroup>

</Project>
